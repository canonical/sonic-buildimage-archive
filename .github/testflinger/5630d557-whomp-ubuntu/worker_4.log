        ecn_mode = "copy_from_outer"
        ttl_mode = supported_ttl_dscp_params['ttl']
        dscp_mode = supported_ttl_dscp_params['dscp']
        vxlan = supported_ttl_dscp_params['vxlan']
        if duthosts[0].facts['asic_type'] in ['mellanox']:
            ecn_mode = 'standard'
    
        try:
