                    recover(duthosts[dut_name], localhost, fanouthosts, nbrhosts, tbinfo, dut_results,
                            recover_method)
    
        except BaseException as e:
            request.config.cache.set(cache_key, True)
            add_custom_msg(request, f"{DUT_CHECK_NAMESPACE}.{cache_key}", True)
