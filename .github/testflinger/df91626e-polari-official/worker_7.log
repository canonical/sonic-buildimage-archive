                               src_port=rx_port_ptf_id,
                               dst_mirror_ports=mirror_port_id,
                               dst_ports=tx_port_ptf_id,
                               meter_type="packets",
                               cir=rate_limit,
                               cbs=rate_limit,
                               send_time=send_time,
